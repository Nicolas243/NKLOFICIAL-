# Portal NKL — variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores.
# Nunca versione o .env.local real.

# -----------------------------------------------------------------------------
# Supabase: banco PostgreSQL, autenticação e Storage
# -----------------------------------------------------------------------------
# Para desenvolvimento local sem Docker, prefira:
# Supabase Dashboard > Project Settings > Database > Connection string >
# URI > Session pooler.
# A senha deve usar URL encoding: @ = %40, # = %23, : = %3A.
DATABASE_URL="postgresql://postgres.[SEU_PROJETO]:[SENHA_CODIFICADA]@[REGIAO].pooler.supabase.com:5432/postgres"

# Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://[SEU_PROJETO].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua_chave_publica"
# Chave somente de servidor para criar URLs temporárias dos ativos pagos.
SUPABASE_SERVICE_ROLE_KEY="sua_service_role_key"

# -----------------------------------------------------------------------------
# Aplicação e SEO
# -----------------------------------------------------------------------------
# URL pública sem barra final.
NEXT_PUBLIC_SITE_URL="https://seu-dominio.com.br"

# -----------------------------------------------------------------------------
# Segurança, cron e administração
# -----------------------------------------------------------------------------
# Gere valores fortes. Exemplo: openssl rand -hex 32
CRON_SECRET="seu_segredo_do_cron"
ADMIN_BOOTSTRAP_SECRET=""
WEBHOOK_SECRET="seu_segredo_hmac"

# -----------------------------------------------------------------------------
# Mercado Pago
# -----------------------------------------------------------------------------
# Configure no painel:
# pagamento único: https://SEU_DOMINIO/api/payments/webhook
# assinatura: https://SEU_DOMINIO/api/payments/subscription-webhook
MERCADOPAGO_ACCESS_TOKEN="seu_access_token"
MERCADOPAGO_WEBHOOK_SECRET="seu_segredo_de_webhook"
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY="sua_public_key"
MERCADOPAGO_CLIENT_ID=""
MERCADOPAGO_CLIENT_SECRET=""
MERCADOPAGO_REDIRECT_URI=""

# -----------------------------------------------------------------------------
# Hotmart — alternativa de checkout
# -----------------------------------------------------------------------------
# Crie os produtos na Hotmart e copie os links públicos de checkout.
HOTMART_GUIDE_CHECKOUT_URL=""
HOTMART_SUBSCRIPTION_CHECKOUT_URL=""
# Configurados no webhook da Hotmart; nunca exponha no navegador.
HOTMART_WEBHOOK_TOKEN=""
HOTMART_GUIDE_PRODUCT_ID=""
HOTMART_SUBSCRIPTION_PRODUCT_ID=""

# -----------------------------------------------------------------------------
# Rate limit — Upstash Redis
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL="https://seu-banco.upstash.io"
UPSTASH_REDIS_REST_TOKEN="seu_token_rest"

# -----------------------------------------------------------------------------
# Salas de aula — Daily.co
# -----------------------------------------------------------------------------
DAILY_API_KEY="sua_chave_secreta_da_daily"

# ---------------------------------------------------------------------------
# Worker local DeepSeek/Cline (somente desenvolvimento local)
# ---------------------------------------------------------------------------
# O worker usa stdio e não deve ser publicado nem exposto na internet.
CLINE_PROVIDER_ID="openai-compatible"
CLINE_MODEL_ID=""
CLINE_API_KEY=""
CLINE_BASE_URL=""

# ---------------------------------------------------------------------------
# Rede auxiliar local 9router (somente desenvolvimento local)
# ---------------------------------------------------------------------------
# O Cline coordena; estes aliases são enviados ao mesmo endpoint compatível.
NINE_ROUTER_PROVIDER_ID="openai-compatible"
NINE_ROUTER_BASE_URL="http://localhost:20128/dashboard"
NINE_ROUTER_API_KEY=""
NINE_ROUTER_ORQUESTRADOR_MODEL="NKL-ORQUESTRADOR"
NINE_ROUTER_WORKER_MODEL="NKL-OPERARIOS"
NINE_ROUTER_REVIEWER_MODEL="NKL-REVISOR"
# Alias literal resolvido pelo 9router quando usado pelo gateway.
NINE_ROUTER_ALL_ALIAS="Alll"
NINE_ROUTER_MAX_WORKERS="3"
NINE_ROUTER_RETRY_LIMIT="1"
