# Portal NKL — variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores.
# Nunca versione o .env.local real.

# -----------------------------------------------------------------------------
# Supabase: banco PostgreSQL, autenticação e Storage
# -----------------------------------------------------------------------------
# Para desenvolvimento local sem Docker, prefira:
# Supabase Dashboard > Project Settings > Database > Connection string >
# URI > Session pooler.
# A senha deve usar URL encoding: @ = %40, # = %23, : = %3A.
DATABASE_URL="postgresql://postgres.[SEU_PROJETO]:[SENHA_CODIFICADA]@[REGIAO].pooler.supabase.com:5432/postgres"

# Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://[SEU_PROJETO].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua_chave_publica"
# Chave somente de servidor para criar URLs temporárias dos ativos pagos.
SUPABASE_SERVICE_ROLE_KEY="sua_service_role_key"
# Chave server-only para criptografar CPF do checkout sem login (gere um valor forte).
GUEST_CHECKOUT_ENCRYPTION_KEY="gere-uma-chave-server-only-com-pelo-menos-32-caracteres"
AD_PROMOTIONAL_PRICE_CENTS="1990"
AD_STANDARD_PRICE_CENTS="6990"
AD_PROMOTION_END_DATE="2026-12-01T00:00:00-03:00"

# Recuperação de acesso por e-mail. Em local, preview não envia mensagens externas.
EMAIL_DELIVERY_MODE="preview"
RESEND_API_KEY=""
EMAIL_FROM="Portal NKL <noreply@example.com>"
EMAIL_REPLY_TO="contato@example.com"
MATERIAL_ADMIN_EMAIL="admin@example.com"

# -----------------------------------------------------------------------------
# Aplicação e SEO
# -----------------------------------------------------------------------------
# URL pública sem barra final.
NEXT_PUBLIC_SITE_URL="https://seu-dominio.com.br"
# IDs públicos de ferramentas de medição; carregados somente após consentimento.
NEXT_PUBLIC_CLARITY_PROJECT_ID=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# -----------------------------------------------------------------------------
# Segurança, cron e administração
# -----------------------------------------------------------------------------
# Gere valores fortes. Exemplo: openssl rand -hex 32
CRON_SECRET="seu_segredo_do_cron"
ADMIN_BOOTSTRAP_SECRET=""
WEBHOOK_SECRET="seu_segredo_hmac"

# -----------------------------------------------------------------------------
# Stripe
# -----------------------------------------------------------------------------
# Configure o endpoint https://SEU_DOMINIO/api/payments/stripe-webhook no painel.
# Use a chave criada na conta Stripe do Portal NKL, não uma credencial de outro
# provedor. Prefira uma chave restrita rk_test_/rk_live_ com apenas as
# permissões necessárias. STRIPE_SECRET_KEY permanece como fallback legado.
STRIPE_API_KEY="rk_test_..."
STRIPE_SECRET_KEY="rk_test_..."
STRIPE_RESTRICTED_KEY_FOR_AGENTS="rk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# IA na Prática NKL: Price IDs criados no Stripe em modo de teste/produção.
AI_ONE_TIME_STRIPE_PRICE_ID="price_..."
AI_SUBSCRIPTION_STRIPE_PRICE_ID="price_..."

# -----------------------------------------------------------------------------
# Rate limit — Upstash Redis
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL="https://seu-banco.upstash.io"
UPSTASH_REDIS_REST_TOKEN="seu_token_rest"

# -----------------------------------------------------------------------------
# Salas de aula — Daily.co
# -----------------------------------------------------------------------------
DAILY_API_KEY="sua_chave_secreta_da_daily"

# ---------------------------------------------------------------------------
# Rede local 9router (modo principal, sem dependência de Cline, Node.js 22+)
# ---------------------------------------------------------------------------
# O servidor MCP chama diretamente /v1/chat/completions e /v1/models do 9router.
NINE_ROUTER_PROVIDER_ID="openai-compatible"
NINE_ROUTER_BASE_URL="http://127.0.0.1:20128/v1"
NINE_ROUTER_API_KEY=""
NINE_ROUTER_ORQUESTRADOR_MODEL="NKL-ORQUESTRADOR"
NINE_ROUTER_WORKER_MODEL="NKL-OPERARIOS"
NINE_ROUTER_REVIEWER_MODEL="NKL-REVISOR"
# Alias literal resolvido pelo 9router quando usado pelo gateway.
NINE_ROUTER_ALL_ALIAS="Alll"
# Máximo de operários paralelos (1 a 3) e tentativas extras por operário (0 ou 1).
NINE_ROUTER_MAX_WORKERS="3"
NINE_ROUTER_RETRY_LIMIT="1"

# ---------------------------------------------------------------------------
# Worker legado DeepSeek/Cline (fallback opcional se NINE_ROUTER_* não existir)
# ---------------------------------------------------------------------------
# O worker usa stdio e não deve ser publicado nem exposto na internet.
CLINE_PROVIDER_ID="openai-compatible"
CLINE_MODEL_ID=""
CLINE_API_KEY=""
CLINE_BASE_URL=""
