# ============================================================
# Portal NKL — Variáveis de Ambiente
# Copie este arquivo para `.env.local` e preencha os valores.
# NUNCA comite o `.env.local` real no repositório.
# ============================================================

# ===== Banco de dados (Postgres / Drizzle ORM) =====
# String de conexão do Supabase: Project Settings > Database >
# Connection string > URI (use a porta 5432 / modo session pooler).
DATABASE_URL="postgresql://postgres:[SUA_SENHA]@db.[SEU_PROJETO].supabase.co:5432/postgres"

# ===== Supabase (Auth + Storage) =====
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://[SEU_PROJETO].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua_chave_anonima_publishable_aqui"

# ===== SEO =====
# URL canônica do site em produção (sem barra final). Base do sitemap.xml.
NEXT_PUBLIC_SITE_URL="https://nkl.com.br"

# ===== Cron — Reconciliação financeira =====
# Protege GET /api/cron/sync-subscriptions via header "Authorization: Bearer <valor>".
# Agende externamente (ex: Vercel Cron, GitHub Actions schedule) a cada hora.
# Gerar com: openssl rand -hex 32
CRON_SECRET="gerar_via_openssl_rand_hex_32"

# ===== Gateway de pagamento (webhooks) =====
# Protege POST /api/webhooks/gateway via header "x-gateway-signature".
# Deve ser idêntico ao segredo configurado no painel do gateway (ex: Mercado Pago).
# Gerar com: openssl rand -hex 32
GATEWAY_WEBHOOK_SECRET="gerar_via_openssl_rand_hex_32"
