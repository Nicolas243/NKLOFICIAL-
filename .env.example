# Portal NKL — variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores.
# Nunca versione o .env.local real.

# -----------------------------------------------------------------------------
# Supabase: banco PostgreSQL, autenticação e Storage
# -----------------------------------------------------------------------------
# Para desenvolvimento local sem Docker, prefira:
# Supabase Dashboard > Project Settings > Database > Connection string >
# URI > Session pooler.
# A senha deve usar URL encoding: @ = %40, # = %23, : = %3A.
DATABASE_URL="postgresql://postgres.[SEU_PROJETO]:[SENHA_CODIFICADA]@[REGIAO].pooler.supabase.com:5432/postgres"

# Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://[SEU_PROJETO].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sua_chave_publica"
# Chave somente de servidor para criar URLs temporárias dos ativos pagos.
SUPABASE_SERVICE_ROLE_KEY="sua_service_role_key"
# Chave server-only para criptografar CPF do checkout sem login (gere um valor forte).
GUEST_CHECKOUT_ENCRYPTION_KEY="gere-uma-chave-server-only-com-pelo-menos-32-caracteres"

# Recuperação de acesso por e-mail. Em local, preview não envia mensagens externas.
EMAIL_DELIVERY_MODE="preview"
RESEND_API_KEY=""
EMAIL_FROM="Portal NKL <noreply@seu-dominio.com.br>"
EMAIL_REPLY_TO=""

# -----------------------------------------------------------------------------
# Aplicação e SEO
# -----------------------------------------------------------------------------
# URL pública sem barra final.
NEXT_PUBLIC_SITE_URL="https://seu-dominio.com.br"
# IDs públicos de ferramentas de medição; carregados somente após consentimento.
NEXT_PUBLIC_CLARITY_PROJECT_ID=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# -----------------------------------------------------------------------------
# Segurança, cron e administração
# -----------------------------------------------------------------------------
# Gere valores fortes. Exemplo: openssl rand -hex 32
CRON_SECRET="seu_segredo_do_cron"
ADMIN_BOOTSTRAP_SECRET=""
WEBHOOK_SECRET="seu_segredo_hmac"

# -----------------------------------------------------------------------------
# Stripe
# -----------------------------------------------------------------------------
# Configure o endpoint https://SEU_DOMINIO/api/payments/stripe-webhook no painel.
# Prefira uma chave restrita rk_test_... com apenas as permissões necessárias.
STRIPE_SECRET_KEY="rk_test_..."
STRIPE_RESTRICTED_KEY_FOR_AGENTS="rk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# -----------------------------------------------------------------------------
# Rate limit — Upstash Redis
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL="https://seu-banco.upstash.io"
UPSTASH_REDIS_REST_TOKEN="seu_token_rest"

# -----------------------------------------------------------------------------
# Salas de aula — Daily.co
# -----------------------------------------------------------------------------
DAILY_API_KEY="sua_chave_secreta_da_daily"
